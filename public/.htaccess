<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /MVC_G1-LIBRARY-MANAGE-SYSTEM/public/

    # Không rewrite file & folder thật
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Tất cả request về index.php
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
