Options -MultiViews
RewriteEngine On

# Set the rewrite base to match your project location
# Update this path to match your setup
RewriteBase /library_mvc_project/public

# If the request is not for an existing file
RewriteCond %{REQUEST_FILENAME} !-f
# And not for an existing directory
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite all requests to index.php with the URL as a query parameter
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
