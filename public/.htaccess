<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Xác định RewriteBase tự động
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]
    
    # Không rewrite các file thật (css, js, images, etc)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Xử lý root URL (/) - chuyển về index.php với url rỗng
    RewriteRule ^$ index.php?url= [L,QSA]
    
    # Rewrite tất cả request khác về index.php với parameter url
    RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

